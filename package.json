{
  "name": "more-than-enough",
  "private": true,
  "license": "MIT",
  "description": "A mobile-first browser game about turning a hostile wilderness into an absurd surplus.",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "test": "node --test \"test/unit/*.test.js\" \"test/property/*.test.js\"",
    "test:e2e": "node test/browser.e2e.js",
    "test:layout": "node test/layout.e2e.js",
    "check": "sh scripts/check.sh",
    "stage": "sh scripts/stage-site.sh site"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
